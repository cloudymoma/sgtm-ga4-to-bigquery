const JSON = require('JSON');
const log = require('logToConsole');
const BigQuery = require('BigQuery');
const makeNumber = require('makeNumber');
const makeInteger = require('makeInteger');
const makeString = require('makeString');
const getType = require('getType');
const isRequestMpv2 = require('isRequestMpv2');
const getRemoteAddress = require('getRemoteAddress');
const getRequestHeader = require('getRequestHeader');
const extractEventsFromMpv2 = require('extractEventsFromMpv2');
const getRequestQueryParameters = require('getRequestQueryParameters');
const getTimestampMillis = require('getTimestampMillis');

// Validate required BigQuery configuration
if (!data.projectId || !data.datasetId || !data.tableId) {
  log('GA4 to BigQuery: Missing required configuration (projectId, datasetId, or tableId).');
  data.gtmOnFailure();
} else if (!isRequestMpv2()) {
  log('GA4 to BigQuery: Request is not a Measurement Protocol v2 (GA4) request.');
  data.gtmOnSuccess();
} else {
  const rows = extractEventsFromMpv2() || [];

  if (rows.length > 0) {
    const connectionInfo = {
      'projectId': data.projectId,
      'datasetId': data.datasetId,
      'tableId': data.tableId
    };

    const options = {
      'ignoreUnknownValues': true,
      'skipInvalidRows': false
    };

    const topLevelKeys = [
      'measurement_id',
      'gtm_version',
      'client_id',
      'user_id',
      'language',
      'screen_resolution',
      'request_count',
      'page_location',
      'page_hostname',
      'page_path',
      'page_referrer',
      'page_encoding',
      'ga_session_id',
      'ga_session_number',
      'session_engagement',
      'page_title',
      'event_name',
      'ir',
      'value',
      'engagement_time_msec',
      'currency',
      'items',
      'gclid',
      'dclid',
      'gbraid',
      'wbraid',
      'gclsrc',
      '_gl',
      'protocol_version',
      'gcs',
      'gcd',
      'dma',
      'npa',
      'gad_source',
      'source_platform',
      'campaign_id',
      'source',
      'medium',
      'campaign',
      'term',
      'content',
      'creative_format',
      'marketing_tactic',
      'firebase_app_id',
      'app_instance_id',
      'app_version',
      'app_name',
      'app_installer_id'
    ];

    // Keys on an extracted event that are handled explicitly or internal to
    // the tag, and must never be turned into event_params entries.
    const nonParamKeys = [
      'event_timestamp',
      'user_agent',
      'ip_address',
      'ip_override',
      'event_params',
      'user_properties',
      'seg',
      'tid',
      'richsstsse',
      'client_hints'
    ];

    // Converts a raw parameter value into an event_params/user_properties
    // value record. Returns undefined for non-scalar values.
    const makeParamValue = (value) => {
      const valueType = getType(value);
      if (valueType === 'number') {
        if (value !== value) {
          return undefined;
        }
        const intVal = makeInteger(value);
        if (intVal === value) {
          return { 'int_value': intVal };
        }
        return { 'float_value': value };
      }
      if (valueType === 'string' || valueType === 'boolean') {
        return { 'string_value': makeString(value) };
      }
      return undefined;
    };

    const paramObj = getRequestQueryParameters() || {};
    const customEventParams = [];
    const customUserProperties = [];

    // Parse event parameters (ep.*, epn.*) and user properties (up.*, upn.*)
    for (const param in paramObj) {
      const dotIndex = param.indexOf('.');
      if (dotIndex > -1) {
        const prefix = param.substring(0, dotIndex);
        const keyString = param.substring(dotIndex + 1);

        if (topLevelKeys.indexOf(keyString) === -1) {
          const value = paramObj[param];
          const obj = {
            'key': keyString,
            'value': {}
          };

          if (prefix === 'epn' || prefix === 'upn') {
            const num = makeNumber(value);
            const intVal = makeInteger(value);
            // makeNumber returns NaN (never undefined) for non-numeric input
            if (num === num) {
              if (intVal === num) {
                obj.value.int_value = intVal;
              } else {
                obj.value.float_value = num;
              }
            } else {
              obj.value.string_value = makeString(value);
            }
          } else {
            // ep./up. parameters are strings by MPv2 definition
            obj.value.string_value = makeString(value);
          }

          if (prefix === 'ep' || prefix === 'epn') {
            customEventParams.push(obj);
          } else if (prefix === 'up' || prefix === 'upn') {
            customUserProperties.push(obj);
          }
        }
      }
    }

    const currentTimestamp = getTimestampMillis() / 1000;
    const userAgent = getRequestHeader('user-agent');
    let remoteIp = undefined;
    if (data.collectIp === true || data.collectIp === 'true') {
      remoteIp = getRemoteAddress();
    }

    const matchedRows = [];

    // Process all events in the batch
    for (let r = 0; r < rows.length; r++) {
      const eventRow = rows[r];

      // Set timestamp, user agent, IP
      eventRow.event_timestamp = currentTimestamp;
      eventRow.user_agent = userAgent;
      if (remoteIp !== undefined) {
        eventRow.ip_address = remoteIp;
      }

      // Populate query parameters if not present on eventRow
      if (paramObj.gcd && !eventRow.gcd) eventRow.gcd = paramObj.gcd;
      if (paramObj.gcs && !eventRow.gcs) eventRow.gcs = paramObj.gcs;
      if (paramObj.gad_source && !eventRow.gad_source) eventRow.gad_source = paramObj.gad_source;
      if (paramObj.dma && !eventRow.dma) eventRow.dma = paramObj.dma;
      if (paramObj.npa && !eventRow.npa) eventRow.npa = paramObj.npa;
      if (paramObj.gclid && !eventRow.gclid) eventRow.gclid = paramObj.gclid;
      if (paramObj.dclid && !eventRow.dclid) eventRow.dclid = paramObj.dclid;
      if (paramObj.gbraid && !eventRow.gbraid) eventRow.gbraid = paramObj.gbraid;
      if (paramObj.wbraid && !eventRow.wbraid) eventRow.wbraid = paramObj.wbraid;
      if (paramObj.gclsrc && !eventRow.gclsrc) eventRow.gclsrc = paramObj.gclsrc;
      if (paramObj._gl && !eventRow._gl) eventRow._gl = paramObj._gl;
      if (paramObj.utm_source_platform && !eventRow.source_platform) eventRow.source_platform = paramObj.utm_source_platform;
      if (paramObj.utm_id && !eventRow.campaign_id) eventRow.campaign_id = paramObj.utm_id;

      // Normalize keys: convert hyphens to underscores and remove known prefixes
      for (const param in eventRow) {
        let newParam = '';
        for (let i = 0; i < param.length; i++) {
          if (param[i] === '-') {
            newParam += '_';
          } else {
            newParam += param[i];
          }
        }
        newParam = newParam.replace('x_ga_', '');
        newParam = newParam.replace('mp2_', '');
        newParam = newParam.replace('utm_', '');
        eventRow[newParam] = eventRow[param];
      }

      if (eventRow.seg !== undefined && eventRow.session_engagement === undefined) {
        eventRow.session_engagement = eventRow.seg;
      }

      // Resolve measurement ID
      const eventMeasurementId = eventRow.measurement_id || eventRow['x-ga-measurement_id'] || paramObj.tid;
      if (eventMeasurementId) {
        eventRow.measurement_id = eventMeasurementId;
      }

      // Build event_params: batched events carry their own params in the
      // request body, so harvest this event's custom keys first, then add
      // shared query-string params not already present.
      const eventParams = [];
      const seenParamKeys = {};
      for (const key in eventRow) {
        if (key.indexOf('-') === -1 && key.indexOf('x_ga_') !== 0 && key[0] !== '_' &&
            topLevelKeys.indexOf(key) === -1 && nonParamKeys.indexOf(key) === -1) {
          const paramValue = makeParamValue(eventRow[key]);
          if (paramValue) {
            eventParams.push({ 'key': key, 'value': paramValue });
            seenParamKeys[key] = true;
          }
        }
      }
      for (let ep = 0; ep < customEventParams.length; ep++) {
        if (!seenParamKeys[customEventParams[ep].key]) {
          eventParams.push(customEventParams[ep]);
        }
      }

      // Build user_properties: from the event's own user-properties object
      // (normalized from x-ga-mp2-user_properties), then shared query-string
      // properties not already present.
      const userProps = [];
      const seenUserPropKeys = {};
      if (getType(eventRow.user_properties) === 'object') {
        for (const key in eventRow.user_properties) {
          const propValue = makeParamValue(eventRow.user_properties[key]);
          if (propValue) {
            userProps.push({ 'key': key, 'value': propValue });
            seenUserPropKeys[key] = true;
          }
        }
      }
      for (let up = 0; up < customUserProperties.length; up++) {
        if (!seenUserPropKeys[customUserProperties[up].key]) {
          userProps.push(customUserProperties[up]);
        }
      }

      eventRow.event_params = eventParams;
      eventRow.user_properties = userProps;

      // Check measurement ID filter
      if (data.measurementId === '*' || eventRow.measurement_id === data.measurementId) {
        matchedRows.push(eventRow);
      }
    }

    if (matchedRows.length === 0) {
      log('GA4 to BigQuery: No events matched the Measurement ID filter (' + data.measurementId + ').');
      data.gtmOnSuccess();
    } else {
      BigQuery.insert(connectionInfo, matchedRows, options)
        .then((result) => {
          log('GA4 to BigQuery: Successfully inserted ' + matchedRows.length + ' event(s).');
          data.gtmOnSuccess();
        }, (error) => {
          log('GA4 to BigQuery: BigQuery insertion failed: ' + JSON.stringify(error));
          data.gtmOnFailure();
        });
    }
  } else {
    log('GA4 to BigQuery: No events found in request.');
    data.gtmOnSuccess();
  }
}


